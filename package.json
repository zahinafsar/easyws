{
  "name": "easyws",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev -w @easyws/server",
    "dev:client": "npm run dev -w @easyws/client",
    "build": "npm run build --workspaces --if-present"
  }
}
